# LLM Providers — OpenRouter is the default gateway.
# Set OPENROUTER_API_KEY to use the default configuration.
OPENROUTER_API_KEY=
# Optional; OpenRouter recommends these for attribution (some accounts require them).
# OPENROUTER_HTTP_REFERER=https://your-site-or-repo.example
# OPENROUTER_APP_TITLE=TradingReportAgents

# Model IDs (same defaults as tradingagents/default_config.py if unset or blank).
LLM_PROVIDER=openrouter
LLM_DEEP_THINK_MODEL=deepseek/deepseek-v4-pro
LLM_QUICK_THINK_MODEL=deepseek/deepseek-v4-flash
LLM_CHART_MODEL=moonshotai/kimi-k2.6
# Optional custom API base, e.g. https://openrouter.ai/api/v1 — leave empty for provider default.
LLM_BACKEND_URL=

# Alternative direct-provider keys (only needed if you override llm_provider)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=

# Optional: point at a remote Ollama server (local default: http://localhost:11434/v1).
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Optional: override DEFAULT_CONFIG without editing code (TRADINGAGENTS_* vars).
#TRADINGAGENTS_LLM_PROVIDER=openrouter
#TRADINGAGENTS_DEEP_THINK_LLM=deepseek/deepseek-v4-pro
#TRADINGAGENTS_QUICK_THINK_LLM=deepseek/deepseek-v4-flash
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1

# Pipeline runtime settings
REPORT_DATE=
NEWS_LOOKBACK_DAYS=7
WATCHLIST_PATH=watchlist.txt
CHART_PERIOD=6mo
CHART_OUTPUT_DIR=output/charts
# Minimum daily % change to include a watchlist stock in charts (default indexes always included)
SIGNIFICANT_CHANGE_PCT=5.0
# Per-chart symbol news for section 4 (defaults: same lookback as NEWS_LOOKBACK_DAYS; 4000 chars/symbol cap)
# CHART_NEWS_LOOKBACK_DAYS=7
# CHART_NEWS_MAX_CHARS_PER_SYMBOL=4000

# Notifier settings
NOTIFY_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

NOTIFY_EMAIL=false
EMAILS_FILE=emails.txt
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
