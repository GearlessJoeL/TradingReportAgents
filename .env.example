# LLM Providers — OpenRouter is the default gateway.
# Set OPENROUTER_API_KEY to use the default configuration.
OPENROUTER_API_KEY=
# Optional; OpenRouter recommends these for attribution (some accounts require them).
# OPENROUTER_HTTP_REFERER=https://your-site-or-repo.example
# OPENROUTER_APP_TITLE=TradingReportAgents

# Model IDs (same defaults as tradingagents/default_config.py if unset or blank).
LLM_PROVIDER=openrouter
LLM_DEEP_THINK_MODEL=deepseek/deepseek-v4-flash
LLM_QUICK_THINK_MODEL=deepseek/deepseek-v4-flash
LLM_CHART_MODEL=moonshotai/kimi-k2.6
# Optional custom API base, e.g. https://openrouter.ai/api/v1 — leave empty for provider default.
LLM_BACKEND_URL=

# Alternative direct-provider keys (only needed if you override llm_provider)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=

# Pipeline runtime settings
REPORT_TICKER=NVDA
REPORT_DATE=
NEWS_LOOKBACK_DAYS=7
WATCHLIST_PATH=watchlist.txt
CHART_PERIOD=6mo
CHART_OUTPUT_DIR=output/charts
# Minimum daily % change to include a watchlist stock in charts (default indexes always included)
SIGNIFICANT_CHANGE_PCT=5.0

# Notifier settings
NOTIFY_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

NOTIFY_EMAIL=false
EMAILS_FILE=emails.txt
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
